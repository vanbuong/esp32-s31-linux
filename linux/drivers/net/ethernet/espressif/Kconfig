config NET_VENDOR_ESPRESSIF
	bool "Espressif devices"
	default y
	help
	  If you have a network device belonging to this class, say Y.

if NET_VENDOR_ESPRESSIF

config ESP32S31_ETH
	tristate "ESP32-S31 Gigabit Ethernet (hart-0 EMAC IPC)"
	depends on SOC_ESP32S31 || COMPILE_TEST
	depends on OF
	help
	  Network device for the ESP32-S31 internal RGMII EMAC, which is driven
	  by ESP-IDF firmware resident on hart 0. Linux exchanges Ethernet
	  frames with that firmware through shared internal SRAM.

	  To compile this driver as a module, choose M here: the module will
	  be called esp32s31-eth.

endif # NET_VENDOR_ESPRESSIF
